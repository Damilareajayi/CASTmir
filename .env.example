# PRISM — Environment Variables
# Copy this file to .env and fill in your values

# COACH (Agent 3) calls AWS Bedrock. No API key needed here — credentials
# are picked up from your local AWS CLI config. Run `aws configure` or
# `aws login` on this machine first. Region and model are optional overrides:
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional: real backend URL (leave blank to use built-in mock data)
# VITE_API_URL=http://localhost:8000
