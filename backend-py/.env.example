# CASTmir backend — copy to .env and fill in as needed. Every value here
# has a working default in config.py; you only need to override what your
# local setup actually requires.

ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173

# DuckDB persists to this local file by default — fine for local dev as-is.
# DUCKDB_PATH=./data/castmir.duckdb

# Leave S3_BACKUP_BUCKET unset locally — the local DuckDB file is already
# persistent, so there's nothing to back up to/restore from. Only set this
# to test the backup/restore path itself; it needs real AWS credentials
# with s3:GetObject/PutObject on the bucket.
# S3_BACKUP_BUCKET=
# S3_BACKUP_KEY=castmir.duckdb
# S3_BACKUP_INTERVAL_SECONDS=60

# COACH and the content-based security classifier both call AWS Bedrock via
# boto3 — no API key goes here. Configure AWS credentials on this machine
# once instead (`aws configure` or `aws login`), with Bedrock model access
# enabled for an Anthropic model in this region.
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Admin dashboard access code — change this for anything beyond local dev.
ADMIN_TOKEN=dev-admin-token-change-in-production
